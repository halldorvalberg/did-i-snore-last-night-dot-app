<!--
  THROWAWAY HARNESS - reference manifest for the smoke test.

  `flutter create .` will generate its own AndroidManifest.xml. After running
  bootstrap.sh, you must MERGE this file's <uses-permission> entries and the
  <service> declaration for flutter_background_service into the generated
  manifest. See README.md "Manifest merge".

  Locked decisions:
    - foregroundServiceType="microphone"
    - NO INTERNET permission, ever
    - usesCleartextTraffic="false"
    - networkSecurityConfig blocks all domains (see network_security_config.xml)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Mic + foreground service. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      DO NOT add android.permission.INTERNET here. The app must be
      network-free; this is a locked decision.

      Phase 1 harness does not include the auto-resume toggle, so we also
      do not add RECEIVE_BOOT_COMPLETED.
    -->

    <application
        android:label="Phase 1 Harness"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          flutter_background_service registers its own service in its own
          manifest, but the foregroundServiceType="microphone" attribute must
          be merged in via the manifest merger. Declaring it here at the
          application level overrides the plugin's default ("dataSync").
        -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="microphone"
            android:exported="false"
            tools:replace="android:foregroundServiceType" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
